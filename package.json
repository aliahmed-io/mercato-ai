{
  "name": "mercato-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mercato AI - Enterprise Sales Forecasting and Inventory Intelligence Platform",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "pnpm --prefix frontend dev",
    "dev:backend": ".\\.venv\\Scripts\\python.exe backend/run.py",
    "build": "pnpm --prefix frontend build",
    "lint": "pnpm --prefix frontend lint",
    "typecheck": "pnpm --prefix frontend typecheck",
    "test": "pnpm --prefix frontend test",
    "test:backend": ".\\.venv\\Scripts\\pytest",
    "test:all": "pnpm --prefix frontend test && .\\.venv\\Scripts\\pytest"
  }
}
